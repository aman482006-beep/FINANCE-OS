# Copy to .env.local for local development. Never commit real credentials.
# VITE_ variables are public to the browser; do not put secrets here.
# Production API URL (public endpoint only)
VITE_API_BASE_URL=http://localhost:8000/api

# Configure actual secrets on the backend only, never in VITE_* variables.
# LLM_API_KEY=
# MARKET_DATA_API_KEY=
# DATABASE_URL=
# REDIS_URL=
